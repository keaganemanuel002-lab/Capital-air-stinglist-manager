<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.BillingListView"
             x:CompileBindings="False">
  <StackPanel Spacing="12">
    <TextBlock Text="Billing List" Classes="h1"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Refresh" Command="{Binding LoadCommand}"/>
      <Button Content="Export to Excel" Command="{Binding ExportToExcelCommand}"/>
    </StackPanel>

    <DataGrid AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              IsReadOnly="True"
              GridLinesVisibility="All"
              Height="520">
      <DataGrid.Columns>
      <DataGridTextColumn Header="#" Binding="{Binding RowLabel}" Width="0.8*"/>
        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="2*"/>
        <DataGridTextColumn Header="Reg" Binding="{Binding Registration}" Width="1.1*"/>
        <DataGridTextColumn Header="Fleet" Binding="{Binding FleetNumber}" Width="0.9*"/>
        <DataGridTextColumn Header="Vehicle Description" Binding="{Binding VehicleDescription}" Width="2*"/>
        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="2*"/>
        <DataGridTextColumn Header="STING" Binding="{Binding StingCountDisplay}" Width="0.8*"/>
        <DataGridTextColumn Header="STING Plus" Binding="{Binding StingPlusCountDisplay}" Width="0.9*"/>
        <DataGridTextColumn Header="STING FM" Binding="{Binding StingFmCountDisplay}" Width="0.9*"/>
        <DataGridTextColumn Header="Live Tracking" Binding="{Binding LiveTrackingCountDisplay}" Width="1*"/>
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
