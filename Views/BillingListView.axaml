<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.BillingListView"
             x:CompileBindings="False">
  <StackPanel Spacing="12">
    <TextBlock Text="Billing List" Classes="h1"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Refresh" Command="{Binding LoadCommand}"/>
      <Button Content="Export to Excel" Command="{Binding ExportToExcelCommand}"/>
    </StackPanel>

    <DataGrid AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              GridLinesVisibility="All"
              Height="520"
              DoubleTapped="Grid_DoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding RowLabel}" Width="0.6*"/>
        <DataGridTextColumn Header="COMPANY" Binding="{Binding Company}" Width="2.4*"/>
        <DataGridTextColumn Header="REG." Binding="{Binding Registration}" Width="1.1*"/>
        <DataGridTextColumn Header="FLT. NO" Binding="{Binding FleetNumber}" Width="1*"/>
        <DataGridTextColumn Header="VEHICLE DESCRIPTION" Binding="{Binding VehicleDescription}" Width="2.2*"/>
        <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="2*"/>
        <DataGridTextColumn Header="" Binding="{Binding PackageCharge}" Width="1.6*"/>
        <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="1.8*"/>
        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.2*"/>
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
