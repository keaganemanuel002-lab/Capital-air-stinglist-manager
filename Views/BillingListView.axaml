<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.BillingListView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <TextBlock Grid.Row="0" Text="Billing List" Classes="h1"/>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="Refresh" Command="{Binding LoadCommand}"/>
      <Button Content="Export to Excel" Command="{Binding ExportToExcelCommand}"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Client" VerticalAlignment="Center" Classes="muted"/>
      <ComboBox Width="260"
                ItemsSource="{Binding AvailableClients}"
                SelectedItem="{Binding SelectedClient}"/>
      <TextBlock Text="Reg Search" VerticalAlignment="Center" Classes="muted"/>
      <TextBox Width="220"
               Watermark="Type registration..."
               Text="{Binding RegistrationSearch, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}"/>
    </StackPanel>

    <DataGrid Grid.Row="3"
              AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              GridLinesVisibility="All"
              DoubleTapped="Grid_DoubleTapped">
      <DataGrid.Styles>
        <Style Selector="DataGridRow">
          <Setter Property="Background" Value="{Binding RowBackground}"/>
          <Setter Property="FontWeight" Value="{Binding RowFontWeight}"/>
        </Style>
        <Style Selector="DataGridCell">
          <Setter Property="Background" Value="{Binding RowBackground}"/>
          <Setter Property="Foreground" Value="{Binding RowForeground}"/>
          <Setter Property="FontWeight" Value="{Binding RowFontWeight}"/>
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding RowLabel}" Width="0.6*"/>
        <DataGridTextColumn Header="COMPANY" Binding="{Binding Company}" Width="2.4*"/>
        <DataGridTextColumn Header="REG." Binding="{Binding Registration}" Width="1.1*"/>
        <DataGridTextColumn Header="FLT. NO" Binding="{Binding FleetNumber}" Width="1*"/>
        <DataGridTextColumn Header="VEHICLE DESCRIPTION" Binding="{Binding VehicleDescription}" Width="2.2*"/>
        <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="3.8*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
