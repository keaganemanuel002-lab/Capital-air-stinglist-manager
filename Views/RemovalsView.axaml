<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.RemovalsView"
             x:CompileBindings="False">
  <StackPanel Spacing="12">
    <TextBlock Text="Removals / Cancellations" Classes="h1"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Add Request" Command="{Binding AddRequestCommand}" Classes="primary"/>
      <Button Content="Edit Selected" Command="{Binding EditSelectedCommand}"/>
      <Button Content="Create Removal Quote" Command="{Binding CreateRemovalQuoteCommand}"/>
      <Button Content="Refresh" Command="{Binding LoadCommand}"/>
    </StackPanel>

    <DataGrid AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              GridLinesVisibility="All"
              Height="520">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*"/>
        <DataGridTextColumn Header="Date Received" Binding="{Binding DateReceived}" Width="1.2*"/>
        <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="2*"/>
        <DataGridTextColumn Header="Reg" Binding="{Binding Registration}" Width="1.2*"/>
        <DataGridTextColumn Header="Fleet" Binding="{Binding FleetNumber}" Width="1*"/>
        <DataGridTextColumn Header="Make/Model" Binding="{Binding MakeModel}" Width="2*"/>
        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.6*"/>
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
