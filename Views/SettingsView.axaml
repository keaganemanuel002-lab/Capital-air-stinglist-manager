<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.SettingsView"
             x:CompileBindings="False">
  <Border Padding="12" Classes="surface">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <TextBlock Text="Settings" Classes="h1"/>

        <Border Classes="card">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Content="Connectivity Settings"
                    MinWidth="190"
                    Classes="primary"
                    Command="{Binding OpenConnectivitySettingsCommand}"/>
            <TextBlock Text="Open popup for Data/Backup, Flickswitch, Wialon, and Firebase connectivity setup."
                       Classes="muted"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="General" Classes="h2"/>
            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Operator name" Classes="muted"/>
                <TextBox Text="{Binding OperatorName}"/>
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBlock Text="Role" Classes="muted"/>
                <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding Role}"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                <TextBlock Text="Default Install Fee (Ex VAT)" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding DefaultInstallFeeExVat}"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Text="Default Removal Fee (Ex VAT)" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding DefaultRemovalFeeExVat}"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                <TextBlock Text="Default Inspection Fee (Ex VAT)" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding DefaultInspectionFeeExVat}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="VAT and Package Pricing" Classes="h2"/>

            <StackPanel Width="220" Spacing="4">
              <TextBlock Text="VAT Rate (%)" Classes="muted"/>
              <NumericUpDown Minimum="0" Maximum="100" Increment="0.1" Value="{Binding VatRate}"/>
            </StackPanel>

            <TextBlock Text="Package Base Prices (Ex VAT)" Classes="muted"/>
            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="STING Base" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding StingBaseExVat}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="STING Plus Base" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding StingPlusBaseExVat}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="STING FM Base" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding StingFmBaseExVat}"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Add-on Prices (Ex VAT)" Classes="muted"/>
            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Panic Button Add-on" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding PanicButtonAddonExVat}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="App Live Tracking Add-on" Classes="muted"/>
                <NumericUpDown Minimum="0" Maximum="1000000" Value="{Binding AppLiveTrackingAddonExVat}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Field Technician Mobile Access" Classes="h2"/>
            <CheckBox Content="Enable Technician API and mobile portal"
                      IsChecked="{Binding TechnicianApiEnabled}"/>

            <StackPanel Width="240" Spacing="4">
              <TextBlock Text="API Port" Classes="muted"/>
              <NumericUpDown Minimum="1024"
                             Maximum="65535"
                             Value="{Binding TechnicianApiPort}"/>
            </StackPanel>

            <TextBlock Text="Portal URLs (use on Android browser, same Wi-Fi/LAN):" Classes="muted"/>
            <TextBox Text="{Binding TechnicianPortalUrls}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="58"/>
            <TextBlock Text="Technician APK sign-in uses desktop Users (username + password)."
                       Classes="muted"
                       FontSize="11"/>
            <TextBlock Text="Only active users with role Admin or Tech can sign in to technician app."
                       Classes="muted"
                       FontSize="11"/>
            <TextBlock Text="Restart app after changing this section."
                       Classes="muted"
                       FontSize="11"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Save Settings" MinWidth="150" Command="{Binding SaveCommand}" Classes="primary"/>
          <TextBlock Text="Settings are auto-saved when values change." Classes="muted" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
