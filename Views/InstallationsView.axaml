<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.InstallationsView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <TextBlock Grid.Row="0" Text="Installations / Scheduling" Classes="h1"/>

    <DockPanel Grid.Row="1" LastChildFill="True">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="12">
        <CheckBox Content="Open only" IsChecked="{Binding ShowOpenOnly}"/>
        <CheckBox Content="Today only" IsChecked="{Binding ShowTodayOnly}"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Set Schedule" Command="{Binding SetScheduleCommand}" Classes="primary"/>
        <Button Content="Clear Schedule" Command="{Binding ClearScheduleCommand}"/>
        <Button Content="Refresh" Command="{Binding LoadCommand}"/>
      </StackPanel>
    </DockPanel>

    <DataGrid Grid.Row="2"
              AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              GridLinesVisibility="All">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Job Card #" Binding="{Binding JobCardReference}" Width="2*"/>
        <DataGridTextColumn Header="Quote" Binding="{Binding QuoteReference}" Width="0.9*"/>
        <DataGridTextColumn Header="Scheduled" Binding="{Binding ScheduledFor}" Width="1.4*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*"/>
        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="2*"/>
        <DataGridTextColumn Header="Reg" Binding="{Binding Registration}" Width="1.2*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
