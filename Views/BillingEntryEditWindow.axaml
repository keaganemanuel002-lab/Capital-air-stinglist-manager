<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StingListManager.Views.BillingEntryEditWindow"
        x:CompileBindings="False"
        Width="880" Height="760"
        MinWidth="840" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}">

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <TextBlock Text="{Binding WindowTitle}" Classes="h2"/>

      <UniformGrid Columns="2" Rows="3">
        <StackPanel Spacing="4">
          <TextBlock Text="Company" Classes="muted"/>
          <TextBox Text="{Binding Company}" Watermark="Company"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Registration" Classes="muted"/>
          <TextBox Text="{Binding Registration}" Watermark="Registration"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Fleet Number" Classes="muted"/>
          <TextBox Text="{Binding FleetNumber}" Watermark="Fleet number"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Tracking Unit Make" Classes="muted"/>
          <ComboBox ItemsSource="{Binding TrackingUnitMakeOptions}"
                    SelectedItem="{Binding TrackingUnitMake}"
                    Width="240"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Package Type" Classes="muted"/>
          <ComboBox ItemsSource="{Binding PackageTypeOptions}"
                    SelectedItem="{Binding StingPackageType}"
                    Width="240"/>
        </StackPanel>
      </UniformGrid>

      <UniformGrid Columns="3" Rows="1">
        <StackPanel Spacing="4">
          <TextBlock Text="Make" Classes="muted"/>
          <TextBox Text="{Binding Make}" Watermark="Vehicle make"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Model" Classes="muted"/>
          <TextBox Text="{Binding Model}" Watermark="Vehicle model"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Colour" Classes="muted"/>
          <TextBox Text="{Binding Colour}" Watermark="Vehicle colour"/>
        </StackPanel>
      </UniformGrid>

      <StackPanel Spacing="4">
        <TextBlock Text="VIN" Classes="muted"/>
        <TextBox Text="{Binding VinNumber}" Watermark="VIN"/>
      </StackPanel>

      <UniformGrid Columns="4" Rows="1">
        <StackPanel Spacing="4">
          <TextBlock Text="IMEI" Classes="muted"/>
          <TextBox Text="{Binding Imei}" Watermark="IMEI"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Serial Number" Classes="muted"/>
          <TextBox Text="{Binding SerialNumber}" Watermark="Serial number"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="ICCID" Classes="muted"/>
          <TextBox Text="{Binding Iccid, UpdateSourceTrigger=PropertyChanged}" Watermark="ICCID"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="SIM Number" Classes="muted"/>
          <TextBox Text="{Binding SimNumber}" Watermark="SIM number"/>
        </StackPanel>
      </UniformGrid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Lookup SIM in Flickswitch"
                Command="{Binding LookupSimCommand}"
                IsEnabled="{Binding !IsLookingUpFlickswitch}"/>
        <TextBlock Text="Looking up in Flickswitch..."
                   IsVisible="{Binding IsLookingUpFlickswitch}"
                   VerticalAlignment="Center"
                   Classes="muted"/>
      </StackPanel>

      <Border Classes="card" Margin="0,4,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="Flickswitch SIM Control"
                     FontWeight="SemiBold"
                     FontSize="12"/>

          <TextBlock Text="Type ICCID and the app will auto-populate SIM details. Use lookup for ICCID/SIM manual search."
                     FontSize="11"
                     Classes="muted"
                     TextWrapping="Wrap"/>

          <TextBlock Text="{Binding FlickswitchStatusMessage}"
                     Foreground="Green"
                     FontSize="12"
                     Opacity="0.9"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <StackPanel IsVisible="{Binding HasFlickswitchRules}" Margin="0,2,0,0">
        <TextBlock Text="Current SIM Rules" Classes="muted"/>
        <Border Background="#F5F5F5" CornerRadius="4" Padding="8">
          <TextBlock Text="{Binding FlickswitchRulesText}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

      <StackPanel Margin="0,2,0,0">
        <TextBlock Text="SIM Balances" Classes="muted"/>
        <Border Background="#F5F5F5" CornerRadius="4" Padding="8">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding FlickswitchBalanceStatusMessage}"
                       Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Airtime:" Classes="muted"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SimAirtimeBalanceDisplay}"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Data:" Classes="muted"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SimDataBalanceDisplay}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="SMS:" Classes="muted"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SimSmsBalanceDisplay}"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Check:" Classes="muted"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SimLastBalanceCheckDisplay}"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Notes" Classes="muted"/>
        <TextBox Text="{Binding Notes}" Watermark="Notes" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Reason" Classes="muted"/>
        <TextBox Text="{Binding Reason}" Watermark="Reason" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Classes="primary"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
