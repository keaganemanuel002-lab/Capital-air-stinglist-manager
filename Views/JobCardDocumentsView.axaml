<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.JobCardDocumentsView"
             x:CompileBindings="False">
  <StackPanel Spacing="10">

    <TextBlock Text="Documents" Classes="h2"/>

    <TextBlock Text="{Binding RequirementStatus}"
           Classes="muted"
           FontSize="12"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <ComboBox SelectedIndex="{Binding KindIndex}" Width="200">
        <ComboBoxItem Content="Signed Quote"/>
        <ComboBoxItem Content="Invoice"/>
        <ComboBoxItem Content="Job Photo"/>
        <ComboBoxItem Content="Other"/>
      </ComboBox>

      <Button Content="Upload" Command="{Binding UploadCommand}" Classes="primary"/>
      <Button Content="Open" Command="{Binding OpenSelectedCommand}"/>
      <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"/>
    </StackPanel>

    <DataGrid AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding Selected}"
              IsReadOnly="True"
              GridLinesVisibility="All"
              Height="420">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="1.1*"/>
        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2.5*"/>
        <DataGridTextColumn Header="Added" Binding="{Binding AddedAt}" Width="1.3*"/>
        <DataGridTextColumn Header="By" Binding="{Binding AddedBy}" Width="1.2*"/>
      </DataGrid.Columns>
    </DataGrid>

  </StackPanel>
</UserControl>
