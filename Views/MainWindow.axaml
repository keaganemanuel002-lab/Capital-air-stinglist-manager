<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StingListManager.ViewModels"
        mc:Ignorable="d"
        x:Class="StingListManager.Views.MainWindow"
        x:CompileBindings="False"
        Width="1100" Height="700"
        MinWidth="1000" MinHeight="650"
        Title="Capital Air (Pty) Ltd">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding GoSearchCommand}"/>
    <KeyBinding Gesture="Ctrl+E" Command="{Binding GoExportCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSettingsCommand}"/>
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">

    <!-- Top bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="16" Classes="topbar">
      <DockPanel>
      <TextBlock Text="Capital Air (Pty) Ltd"
           Classes="h2"
           DockPanel.Dock="Left"/>
      <Button Content="Products"
        Command="{Binding OpenProductCatalogCommand}"
        DockPanel.Dock="Right"
        Classes="primary"
        Margin="10,0,0,0"/>
      <Button Content="Import Excel"
        Command="{Binding ImportExcelCommand}"
        DockPanel.Dock="Right"
        IsVisible="{Binding CanImportExcel}"
        Margin="10,0,0,0"/>
      <TextBlock Text="Quotes → Install → Job Cards → Billing"
           Classes="muted"
           VerticalAlignment="Center"
           DockPanel.Dock="Right"/>
      </DockPanel>
    </Border>

    <!-- Left nav -->
    <Border x:Name="SidebarNav"
            Grid.Row="1"
            Grid.Column="0"
            Width="74"
            Classes="sidebar"
            PointerEntered="Sidebar_PointerEntered"
            PointerExited="Sidebar_PointerExited">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.15"/>
        </Transitions>
      </Border.Transitions>
      <StackPanel Margin="12" Spacing="8">
        <TextBlock x:Name="NavTitle" Text="Navigation" Classes="h2" Margin="6,10,0,6" IsVisible="False"/>
        <ListBox x:Name="CollapsedNavList"
                 SelectedIndex="{Binding NavIndex}"
                 Classes="nav nav-icons">
          <ListBoxItem ToolTip.Tip="Search"><TextBlock Text="🔍" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Dashboard"><TextBlock Text="📊" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Quotes"><TextBlock Text="🧾" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Installations"><TextBlock Text="🛠" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Job Cards"><TextBlock Text="📋" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Removals / Cancellations"><TextBlock Text="🗑" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="STING List"><TextBlock Text="📄" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Billing List"><TextBlock Text="💰" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Clients"><TextBlock Text="👥" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Monthly Export"><TextBlock Text="📤" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Settings"><TextBlock Text="⚙" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Wialon Reports"><TextBlock Text="📈" Classes="nav-icon"/></ListBoxItem>
          <ListBoxItem ToolTip.Tip="Dashcams"><TextBlock Text="📷" Classes="nav-icon"/></ListBoxItem>
        </ListBox>

        <ListBox x:Name="ExpandedNavList"
                 SelectedIndex="{Binding NavIndex}"
                 Classes="nav"
                 IsVisible="False">
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🔍" Classes="nav-icon"/>
              <TextBlock Text="Search"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📊" Classes="nav-icon"/>
              <TextBlock Text="Dashboard"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🧾" Classes="nav-icon"/>
              <TextBlock Text="Quotes"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🛠" Classes="nav-icon"/>
              <TextBlock Text="Installations"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📋" Classes="nav-icon"/>
              <TextBlock Text="Job Cards"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🗑" Classes="nav-icon"/>
              <TextBlock Text="Removals / Cancellations"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📄" Classes="nav-icon"/>
              <TextBlock Text="STING List"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="💰" Classes="nav-icon"/>
              <TextBlock Text="Billing List"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="👥" Classes="nav-icon"/>
              <TextBlock Text="Clients"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📤" Classes="nav-icon"/>
              <TextBlock Text="Monthly Export"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⚙" Classes="nav-icon"/>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📈" Classes="nav-icon"/>
              <TextBlock Text="Wialon Reports"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📷" Classes="nav-icon"/>
              <TextBlock Text="Dashcams"/>
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- Main content area -->
    <Border Grid.Row="1" Grid.Column="1" Padding="20">
      <ContentControl Content="{Binding CurrentPage}"/>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="2" Grid.ColumnSpan="2"
            Padding="10"
            Classes="statusbar">
      <DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" />
        <TextBlock Text="{Binding StatusTime}" Classes="muted" DockPanel.Dock="Right"/>
      </DockPanel>
    </Border>

  </Grid>
</Window>
