<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.ClientsView"
             x:CompileBindings="False">
  <StackPanel Spacing="12">
    <TextBlock Text="Clients" Classes="h1"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Width="240" Watermark="Search client..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="New" Click="NewClient_Click" Classes="primary"/>
      <Button Content="Edit" Click="EditClient_Click"/>
      <Button Content="Delete" Command="{Binding DeleteCommand}"/>
      <Button Content="Sync from Wialon" Command="{Binding SyncNowCommand}"/>
    </StackPanel>

    <DataGrid AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              GridLinesVisibility="All"
              Height="620"
              DoubleTapped="Grid_DoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Client" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="1.5*"/>
        <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="1.2*"/>
        <DataGridTextColumn Header="Email" Binding="{Binding EmailAddress}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
