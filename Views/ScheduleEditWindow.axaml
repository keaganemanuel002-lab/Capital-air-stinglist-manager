<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StingListManager.Views.ScheduleEditWindow"
        x:CompileBindings="False"
        Width="420" Height="260"
        WindowStartupLocation="CenterOwner"
        Title="Set Schedule">

  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Set Job Schedule" Classes="h2"/>

    <TextBlock Text="Date" Classes="muted"/>
    <DatePicker SelectedDate="{Binding Date}"/>

    <TextBlock Text="Time (HH:mm)" Classes="muted"/>
    <TextBox Text="{Binding TimeText}" Watermark="e.g. 08:30"/>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}"/>
      <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary"/>
    </StackPanel>
  </StackPanel>
</Window>
