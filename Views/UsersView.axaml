<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="StingListManager.Views.UsersView"
             x:CompileBindings="False">

  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="2*,1*" RowSpacing="8" ColumnSpacing="12">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Users" Classes="h1"/>
      <Button Content="Refresh"
              Command="{Binding RefreshCommand}"/>
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="0" Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="Create User" Classes="h2"/>
        <Grid ColumnDefinitions="2*,2*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Watermark="Username"
                   Text="{Binding NewUsername}"/>
          <TextBox Grid.Column="1"
                   Watermark="Password"
                   Text="{Binding NewPassword}"/>
          <ComboBox Grid.Column="2"
                    Width="110"
                    ItemsSource="{Binding RoleOptions}"
                    SelectedItem="{Binding NewRole}"/>
          <CheckBox Grid.Column="3"
                    VerticalAlignment="Center"
                    IsChecked="{Binding NewIsActive}"
                    Content="Active"/>
          <Button Grid.Column="4"
                  Content="Create"
                  Command="{Binding CreateUserCommand}"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="Selected User Actions" Classes="h2"/>
        <TextBlock Text="{Binding SelectedUser.Username, StringFormat='User: {0}'}" Classes="muted"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox Grid.Column="0"
                    ItemsSource="{Binding RoleOptions}"
                    SelectedItem="{Binding SelectedUserRole}"/>
          <Button Grid.Column="1"
                  Content="Apply Role"
                  Command="{Binding ApplySelectedRoleCommand}"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Watermark="New password"
                   Text="{Binding ResetPassword}"/>
          <Button Grid.Column="1"
                  Content="Reset Password"
                  Command="{Binding ResetSelectedPasswordCommand}"/>
          <Button Grid.Column="2"
                  Content="Enable/Disable"
                  Command="{Binding ToggleSelectedActiveCommand}"/>
          <Button Grid.Column="3"
                  Content="Delete"
                  Command="{Binding DeleteSelectedCommand}"/>
        </Grid>
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="2" Grid.ColumnSpan="2"
              ItemsSource="{Binding Users}"
              SelectedItem="{Binding SelectedUser}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*"/>
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*"/>
        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="*"/>
        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
