<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StingListManager.Views.DriverTagExitWindow"
        x:CompileBindings="False"
        Width="620" Height="420"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Title="Record Driver Exit">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Record Driver Exit" Classes="h2"/>

    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Tag Code" Classes="muted"/>
        <TextBlock Text="{Binding TagCode}" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Driver" Classes="muted"/>
        <TextBlock Text="{Binding DriverName}" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Exit Type" Classes="muted"/>
        <ComboBox ItemsSource="{Binding ExitTypeOptions}" SelectedItem="{Binding SelectedExitType}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Exit Date" Classes="muted"/>
        <DatePicker SelectedDate="{Binding ExitDate, Mode=TwoWay}"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Tag Return Status" Classes="muted"/>
        <ComboBox ItemsSource="{Binding ReturnOptions}" SelectedItem="{Binding SelectedReturnStatus}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Returned Date" Classes="muted"/>
        <DatePicker SelectedDate="{Binding ReturnedAt, Mode=TwoWay}"
                    IsEnabled="{Binding IsReturnedSelected}"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Command="{Binding CancelCommand}"/>
      <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary"/>
    </StackPanel>
  </StackPanel>
</Window>
