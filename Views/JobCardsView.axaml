<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StingListManager.Views.JobCardsView"
             x:CompileBindings="False">
  <StackPanel Spacing="12">
    <TextBlock Text="Job Cards" Classes="h1"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Edit Selected" Command="{Binding EditSelectedCommand}" Classes="primary"/>
      <Button Content="Complete Selected" Command="{Binding CompleteSelectedCommand}"
              IsEnabled="{Binding CanCompleteJobs}"/>
      <Button Content="Export Selected to PDF" Command="{Binding ExportSelectedToPdfCommand}" IsEnabled="{Binding HasSelectedRows}"/>
      <Button Content="Documents" Command="{Binding OpenDocumentsCommand}"/>
      <Button Content="Refresh" Command="{Binding LoadCommand}"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <ComboBox Width="140" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
      <ComboBox Width="140" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"/>
      <TextBox Width="200" Watermark="Company..." Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBox Width="160" Watermark="Reg..." Text="{Binding RegistrationFilter, UpdateSourceTrigger=PropertyChanged}"/>
      <DatePicker Width="140" SelectedDate="{Binding StartDate}"/>
      <DatePicker Width="140" SelectedDate="{Binding EndDate}"/>
      <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}"/>
    </StackPanel>

    <DataGrid AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              SelectionMode="Extended"
              IsReadOnly="True"
              GridLinesVisibility="All"
              Height="520"
              DoubleTapped="Grid_DoubleTapped"
              SelectionChanged="Grid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding JobCardNumber}" Width="0.7*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="1*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*"/>
        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="2*"/>
        <DataGridTextColumn Header="Reg" Binding="{Binding Registration}" Width="1.2*"/>
        <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="1.2*"/>
        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="1.2*"/>
        <DataGridTextColumn Header="IMEI" Binding="{Binding Imei}" Width="1.5*"/>
        <DataGridTextColumn Header="Serial #" Binding="{Binding SerialNumber}" Width="1.5*"/>
        <DataGridTextColumn Header="ICCID" Binding="{Binding Iccid}" Width="1.8*"/>
        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="1.5*"/>
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
