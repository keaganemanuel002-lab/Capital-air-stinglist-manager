<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StingListManager.Views.JobCardEditWindow"
        x:CompileBindings="False"
        Width="560" Height="900"
        WindowStartupLocation="CenterOwner"
        Title="Edit Job Card">

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">

    <TextBlock Text="Edit Job Card" Classes="h2"/>

    <TextBlock Text="{Binding EditableWarning}"
               IsVisible="{Binding !IsEditable}"
               Foreground="#B91C1C"
               FontWeight="SemiBold"/>

    <StackPanel Spacing="12"
                IsHitTestVisible="{Binding IsEditable}"
                Opacity="{Binding EditSectionOpacity}">

    <StackPanel>
      <TextBlock Text="Company" Classes="muted"/>
      <ComboBox IsVisible="{Binding ShowTransferCompanyPicker}"
                ItemsSource="{Binding ClientNames}"
                SelectedItem="{Binding SelectedClientName}"
                Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"
                IsEditable="True"/>
      <TextBox IsVisible="{Binding ShowReadOnlyCompany}"
               Text="{Binding Company}"
               IsReadOnly="True"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <StackPanel Width="220">
        <TextBlock Text="Registration" Classes="muted"/>
        <TextBox Text="{Binding Registration}"/>
      </StackPanel>

      <StackPanel Width="220">
        <TextBlock Text="Fleet Number" Classes="muted"/>
        <TextBox Text="{Binding FleetNumber}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <StackPanel Width="165">
        <TextBlock Text="Make" Classes="muted"/>
        <TextBox x:Name="MakeTextBox" Text="{Binding Make, UpdateSourceTrigger=PropertyChanged}"/>
        <ListBox x:Name="MakesListBox"
                 ItemsSource="{Binding FilteredMakes}" 
                 IsVisible="{Binding ShowMakesList}"
                 MaxHeight="120"
                 Margin="0,2,0,0"
                 HorizontalAlignment="Left"
                 Width="165"/>
      </StackPanel>
      <StackPanel Width="165">
        <TextBlock Text="Model" Classes="muted"/>
        <TextBox x:Name="ModelTextBox" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
        <ListBox x:Name="ModelsListBox"
                 ItemsSource="{Binding FilteredModels}"
                 IsVisible="{Binding ShowModelsList}"
                 MaxHeight="120"
                 Margin="0,2,0,0"
                 HorizontalAlignment="Left"
                 Width="165"/>
      </StackPanel>
      <StackPanel Width="165">
        <TextBlock Text="Colour" Classes="muted"/>
        <TextBox Text="{Binding Colour}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="VIN (Vehicle Identification Number)" Classes="muted"/>
      <TextBox Text="{Binding VinNumber}"/>
    </StackPanel>

    <Separator Margin="0,8"/>

    <TextBlock Text="Tracking Unit Information" Classes="h2"/>
    
    <StackPanel Orientation="Horizontal" Spacing="10">
      <StackPanel Width="252">
        <TextBlock Text="Tracking Unit Make" Classes="muted"/>
        <TextBox Text="{Binding TrackingUnitMake}" Watermark="e.g. Concox, Queclink"/>
      </StackPanel>
      <StackPanel Width="252">
        <TextBlock Text="IMEI Number" Classes="muted"/>
        <TextBox Text="{Binding Imei}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <StackPanel Width="165">
        <TextBlock Text="Serial Number" Classes="muted"/>
        <TextBox Text="{Binding SerialNumber}"/>
      </StackPanel>
      <StackPanel Width="165">
        <TextBlock Text="ICCID" Classes="muted"/>
        <TextBox Text="{Binding Iccid, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Width="165">
        <TextBlock Text="SIM Number" Classes="muted"/>
        <TextBox Text="{Binding SimNumber}"/>
      </StackPanel>
    </StackPanel>

    <Border Classes="card" Margin="0,8,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Flickswitch SIM Control"
                   FontWeight="SemiBold"
                   FontSize="12"/>

        <TextBlock Text="Type ICCID and the app will automatically populate SIM Number and rules from Flickswitch."
                   FontSize="11"
                   Classes="muted"/>

        <TextBlock Text="Looking up in Flickswitch..."
                   IsVisible="{Binding IsLookingUpFlickswitch}"
                   FontSize="11"
                   Classes="muted"/>

        <TextBlock Text="{Binding FlickswitchStatusMessage}"
                   Foreground="Green"
                   FontSize="12"
                   Opacity="0.9"/>
      </StackPanel>
    </Border>

    <StackPanel IsVisible="{Binding HasFlickswitchRules}" Margin="0,4,0,0">
      <TextBlock Text="Current SIM Rules" Classes="muted"/>
      <Border Background="#F5F5F5" CornerRadius="4" Padding="8">
        <TextBlock Text="{Binding FlickswitchRulesText}" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>
    </StackPanel>

    <StackPanel Margin="0,4,0,0">
      <TextBlock Text="SIM Balances" Classes="muted"/>
      <Border Background="#F5F5F5" CornerRadius="4" Padding="8">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding FlickswitchBalanceStatusMessage}"
                     Classes="muted"
                     FontSize="11"
                     TextWrapping="Wrap"/>

          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Airtime:" Classes="muted"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SimAirtimeBalanceDisplay}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Data:" Classes="muted"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SimDataBalanceDisplay}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="SMS:" Classes="muted"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SimSmsBalanceDisplay}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Check:" Classes="muted"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SimLastBalanceCheckDisplay}"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}"/>
      <Button Content="Save"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding IsEditable}"
              Classes="primary"/>
    </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
