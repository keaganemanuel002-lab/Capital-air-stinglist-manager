<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StingListManager.Views.DashcamEditorWindow"
        x:CompileBindings="False"
        Width="1100" Height="760"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Title="Dashcam Editor">

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Dashcam Details" Classes="h2"/>
          <TextBlock Text="{Binding Selected.DeviceId, StringFormat='Editing Device: {0}'}" Classes="muted"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Save Dashcam" Command="{Binding SaveSelectedCommand}" Classes="primary"/>
          <Button Content="Close" Click="Close_Click"/>
        </StackPanel>
      </DockPanel>

      <Border Classes="surface">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock Text="Vehicle"/>
              <TextBox Text="{Binding Selected.Vehicle, Mode=TwoWay}" Watermark="Vehicle number or registration"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <TextBlock Text="Device ID"/>
              <TextBox Text="{Binding Selected.DeviceId, Mode=TwoWay}" Watermark="Enter dashcam device ID"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
              <TextBlock Text="WIFI Password"/>
              <TextBox Text="{Binding Selected.WifiPassword, Mode=TwoWay}" Watermark="Enter WIFI password"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
              <TextBlock Text="ISUP Password"/>
              <TextBox Text="{Binding Selected.IsupPassword, Mode=TwoWay}" Watermark="Enter ISUP password"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
              <TextBlock Text="Interior Cam"/>
              <TextBox Text="{Binding Selected.InteriorCam, Mode=TwoWay}" Watermark="yes/no"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
              <TextBlock Text="Rear Cam"/>
              <TextBox Text="{Binding Selected.RearCam, Mode=TwoWay}" Watermark="yes/no"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="4">
              <TextBlock Text="Installed"/>
              <TextBox Text="{Binding Selected.Installed, Mode=TwoWay}" Watermark="e.g. 17/08/2022"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
              <TextBlock Text="Location"/>
              <TextBox Text="{Binding Selected.Location, Mode=TwoWay}" Watermark="e.g. CT / sent to Durban / IN STOCK"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
              <TextBlock Text="Issue"/>
              <TextBox Text="{Binding Selected.Issue, Mode=TwoWay}"
                       Watermark="Issue or fault notes"
                       AcceptsReturn="True"
                       MinHeight="70"
                       TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
              <TextBlock Text="Upgrade Steps"/>
              <TextBox Text="{Binding Selected.UpgradeSteps, Mode=TwoWay}"
                       Watermark="Any upgrade step notes"
                       AcceptsReturn="True"
                       MinHeight="70"
                       TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="surface">
        <StackPanel Spacing="10">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="SD Cards" Classes="h2"/>
              <TextBlock Text="Each dashcam has 2 active SD card slots. Set Changed At when a card is replaced." Classes="muted"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
              <Button Content="Add SD Card" Command="{Binding AddSdCardCommand}" />
              <Button Content="Delete SD Card" Command="{Binding DeleteSdCardCommand}" />
              <Button Content="Save SD Card" Command="{Binding SaveSdCardCommand}" Classes="primary"/>
            </StackPanel>
          </DockPanel>

          <ListBox x:Name="SdCardsListBox"
                   ItemsSource="{Binding SdCards}"
                   SelectedItem="{Binding SelectedSdCard, Mode=TwoWay}"
                   MinHeight="170">
           <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="0.7*,2*,1.2*,1.2*" ColumnSpacing="8" Margin="2,4">
                  <TextBlock Grid.Column="0" Text="{Binding SlotNumber, StringFormat='Slot {0}'}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding SerialNumber, StringFormat='SD: {0}'}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="2" Text="{Binding InstalledAt, StringFormat='Installed: {0:d}'}" Classes="muted"/>
                  <TextBlock Grid.Column="3" Text="{Binding ChangedAt, StringFormat='Changed: {0:d}'}" Classes="muted"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid ColumnDefinitions="1*,1.6*,1.2*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock Text="SD Slot"/>
              <ComboBox ItemsSource="{Binding SdSlots}"
                        SelectedItem="{Binding SelectedSdCard.SlotNumber, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <TextBlock Text="SD Serial Number"/>
              <TextBox Text="{Binding SelectedSdCard.SerialNumber, Mode=TwoWay}" Watermark="Enter SD card serial"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
              <TextBlock Text="Installed At"/>
              <DatePicker SelectedDate="{Binding SelectedSdCard.InstalledAt, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
              <TextBlock Text="Changed At"/>
              <DatePicker SelectedDate="{Binding SelectedSdCard.ChangedAt, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
              <TextBlock Text="Installed In Vehicle"/>
              <TextBox Text="{Binding SelectedSdCard.InstalledInVehicleRegistration, Mode=TwoWay}" Watermark="Registration number"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="4">
              <TextBlock Text="SD Notes"/>
              <TextBox Text="{Binding SelectedSdCard.Notes, Mode=TwoWay}"
                       Watermark="Add SD card notes"
                       AcceptsReturn="True"
                       MinHeight="90"
                       TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
